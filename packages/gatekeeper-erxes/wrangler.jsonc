{
  "name": "gatekeeper-erxes",
  "main": ".wrangler/validate/src/erxes.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src",
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "global_fetch_strictly_public"],
  "rules": [
    { "type": "Text", "globs": ["**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["ErxesLoginAccount", "ExecutorGatekeeper"],
    },
  ],
  "vars": {
    "BASE_URL": "https://os-erxes.darjs.dev/gatekeeper/erxes",
    "MCP_ALLOW_INSECURE": "false",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
  },
}
